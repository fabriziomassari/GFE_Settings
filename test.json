{
  "version": "2026.08.1",
  "selectors": {
    "sidebarContainer": "bard-sidenav, side-navigation-v2, .sidenav-with-history-container",
    "chatsSection": "expandable-section[data-test-id=\"chats-expandable-section\"]",
    "conversationsList": "conversations-list[data-test-id=\"all-conversations\"]",
    "chatItem": "gem-nav-list-item[data-test-id=\"conversation\"] a, a[href*=\"/app/\"]",
    "chatTitle": ".title-text",
    "recentHistoryIcon": "[fonticon=\"history\"], [data-mat-icon-name=\"history\"]"
  },
  "features": {
    "enableDirectInjection": true,
    "enableDragAndDrop": true,
    "enableAiCategorization": true,
    "enableStrategicSynthesis": true,
    "maintenanceBanner": {
      "active": false,
      "message": ""
    }
  },
  "minExtensionVersion": "5.11.0"
}

{
  "schemaVersion": 1,
  "configVersion": "2026.08.19.2",
  "minExtensionVersion": "5.12.0",
  "ttlHours": 6,
  "selectors": {
    "sidebarContainer": "bard-sidenav, side-navigation-v2, .sidenav-with-history-container",
    "sidebarHistoryContainer": ".sidenav-with-history-container",
    "newLayoutChatsSection": "expandable-section[data-test-id=\"chats-expandable-section\"], expandable-section[storagekey=\"chats\"]",
    "conversationsListContainer": "conversations-list[data-test-id=\"all-conversations\"], conversations-list",
    "chatItem": "conversations-list[data-test-id=\"all-conversations\"] gem-nav-list-item[data-test-id=\"conversation\"] a, conversations-list[data-test-id=\"all-conversations\"] a[href*=\"/app/\"], conversations-list[data-test-id=\"all-conversations\"] a[href*=\"/chat/\"], conversations-list a[href*=\"/app/\"]",
    "chatTitle": ".title-text",
    "scroller": "infinite-scroller, main infinite-scroller, conversations-list[data-test-id=\"all-conversations\"]",
    "userProfileBtn": "a[href*=\"accounts.google.com/SignOutOptions\"], button[aria-label*=\"@\"]",
    "userProfileImg": "img[src*=\"googleusercontent.com/a/\"]",
    "myStuffBtn": "side-nav-entry-button[data-test-id=\"my-stuff-side-nav-entry-button\"]",
    "signInLink": "a[href*=\"/signin\"], a[href*=\"ServiceLogin\"], a[href*=\"accounts.google.com\"]",
    "gemHeader": ".gems-list-container .title-container"
  },
  "heuristics": {
    "chatsSectionFallback": "expandable-section[storagekey=\"chats\"], [aria-controls*=\"chats\"]",
    "chatRoutePattern": "/app/[a-f0-9]{16,}",
    "chatRoutePrefix": "/app/",
    "legacyChatRoutePrefix": "/chat/"
  },
  "features": {
    "maintenance": {
      "active": true,
      "message": "Messaggio di prova"
    }
  }
}
